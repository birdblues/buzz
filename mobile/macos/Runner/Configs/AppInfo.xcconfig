// Application-level settings for the Runner target.
//
// Identity comes from the project-level Flutter-{Debug,Release}.xcconfig
// (BUNDLE_IDENTIFIER, APP_DISPLAY_NAME, signing), so worktree and developer
// overrides apply here too.

// The application's name: also the .app file name, so no spaces.
PRODUCT_NAME = BuzzClient

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_IDENTIFIER)

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Block, Inc. and contributors. All rights reserved.
